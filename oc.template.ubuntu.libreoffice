# default TAG is dev
ARG TAG=dev
ARG BASE_IMAGE
FROM ${BASE_IMAGE}:${TAG}

RUN apt-get update && apt-get install -y --no-install-recommends \
	  dbus-x11 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# add libreoffice
RUN apt-get update && apt-get install -y \
	  libreoffice \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*
